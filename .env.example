# ============= SERVER CONFIGURATION =============
NODE_ENV=development
PORT=3000
HOST=localhost

# ============= DATABASE CONFIGURATION =============
# Copy these values to .env and update with your actual credentials
# For local development: root user with password usually works
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=rtk_hardware

# ============= SECURITY CONFIGURATION =============
# JWT Secret: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_character_jwt_secret_key_here_change_in_production

# CORS: Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting (in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# ============= API CONFIGURATION =============
API_DOCS_URL=http://localhost:3000/api-docs
API_TIMEOUT_MS=10000

# ============= EMAIL CONFIGURATION =============
# Optional: For password reset and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SENDER_EMAIL=noreply@rtkhardware.ua

# ============= ADMIN MASTER PASSWORD (Development only) =============
# ⚠️ SECURITY WARNING: NEVER enable this in production!
# This is a development-only feature to allow "admin123" as fallback password
ADMIN_MASTER_PASSWORD_ENABLED=true
ADMIN_MASTER_PASSWORD=admin123
